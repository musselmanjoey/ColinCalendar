# Copy to wallcal.env and fill in. wallcal.env is gitignored: the feed URLs are
# private (anyone with one can read that calendar), so treat them like passwords.
# Any calendar whose URL is left blank is skipped.

# Google: Calendar settings -> (calendar) -> Integrate calendar -> "Secret address in iCal format"
# iCloud: Calendar app -> share calendar -> Public Calendar -> copy link (webcal:// is fine, it's converted)
JOEY_NAME=Joey
JOEY_COLOR=#5DADE2
JOEY_ICS_URL=

PARTNER_NAME=Wife
PARTNER_COLOR=#F1948A
PARTNER_ICS_URL=

# The ColinCalendar web app's feed: https://<your-vercel-app>/api/calendar.ics?token=<CALENDAR_FEED_TOKEN>
SHARED_NAME=Shared
SHARED_COLOR=#82E0AA
SHARED_ICS_URL=

HOLIDAYS_NAME=Holidays
HOLIDAYS_COLOR=#B2BABB
HOLIDAYS_ICS_URL=https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics

# Weather (Open-Meteo, no key needed). Default: Charlotte, NC.
WEATHER_LAT=35.2271
WEATHER_LON=-80.8431

# TV schedule (24h HH:MM). setup.sh writes these into the crontab.
TV_ON_TIME=06:30
TV_OFF_TIME=23:00

# 0.0-1.0. Re-run `node render-config.js` after changing anything in this file.
BRIGHTNESS=0.8
